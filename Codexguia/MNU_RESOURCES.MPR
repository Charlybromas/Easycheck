SET SYSMENU TO
SET SYSMENU AUTOMATIC

DEFINE PAD _5vg1augod OF _MSYSMENU PROMPT "Catalogos" COLOR SCHEME 3 ;
	KEY ALT+C, ""
DEFINE PAD _5vg1augoe OF _MSYSMENU PROMPT "Padrones" COLOR SCHEME 3 ;
	KEY ALT+P, ""
DEFINE PAD _5vg1augof OF _MSYSMENU PROMPT "Asistencias" COLOR SCHEME 3 ;
	KEY ALT+A, ""
DEFINE PAD _5vg1augog OF _MSYSMENU PROMPT "Tools" COLOR SCHEME 3 ;
	KEY ALT+T, ""
DEFINE PAD _5vg1augoh OF _MSYSMENU PROMPT "Reportes" COLOR SCHEME 3 ;
	KEY ALT+R, ""
DEFINE PAD _5vg1augoi OF _MSYSMENU PROMPT "Salir" COLOR SCHEME 3 ;
	KEY ALT+S, ""
ON PAD _5vg1augod OF _MSYSMENU ACTIVATE POPUP catalogos
ON PAD _5vg1augoe OF _MSYSMENU ACTIVATE POPUP padrones
ON PAD _5vg1augof OF _MSYSMENU ACTIVATE POPUP asistencia
ON PAD _5vg1augog OF _MSYSMENU ACTIVATE POPUP tools
ON SELECTION PAD _5vg1augoi OF _MSYSMENU clear events

DEFINE POPUP catalogos MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF catalogos PROMPT "Areas"
DEFINE BAR 2 OF catalogos PROMPT "Puestos"
DEFINE BAR 3 OF catalogos PROMPT "Turnos"
DEFINE BAR 4 OF catalogos PROMPT "\-"
DEFINE BAR 5 OF catalogos PROMPT "Usuarios"
DEFINE BAR 6 OF catalogos PROMPT "Configuracion"
ON SELECTION BAR 3 OF catalogos do form Cat_Turnos
ON SELECTION BAR 5 OF catalogos Do form Cfg_Users
ON SELECTION BAR 6 OF catalogos do Form Cfg_Valores

DEFINE POPUP padrones MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF padrones PROMPT "Icatlax"
ON SELECTION BAR 1 OF padrones do form Frm_IcatlaxPad

DEFINE POPUP asistencia MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF asistencia PROMPT "Reloj Chido"
ON SELECTION BAR 1 OF asistencia do form frm_asistencias

DEFINE POPUP tools MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF tools PROMPT "Cumpleaños Icatlax"
DEFINE BAR 2 OF tools PROMPT "Importar / Exportar"
ON SELECTION BAR 1 OF tools do form Frm_CumpleIca
ON SELECTION BAR 2 OF tools do form Frm_Tools
