SET SYSMENU TO
SET SYSMENU AUTOMATIC

DEFINE PAD _6741333rf OF _MSYSMENU PROMPT "Catalogos" COLOR SCHEME 3 ;
	KEY ALT+C, ""
DEFINE PAD _6741333rg OF _MSYSMENU PROMPT "Cheques" COLOR SCHEME 3 ;
	KEY ALT+C, ""
DEFINE PAD _6741333rh OF _MSYSMENU PROMPT "Informes" COLOR SCHEME 3 ;
	KEY ALT+I, ""
DEFINE PAD _6741333ri OF _MSYSMENU PROMPT "Herramientas" COLOR SCHEME 3 ;
	KEY ALT+H, ""
DEFINE PAD _6741333rj OF _MSYSMENU PROMPT "Ayuda" COLOR SCHEME 3 ;
	KEY ALT+A, ""
DEFINE PAD _6741333rk OF _MSYSMENU PROMPT "Salir" COLOR SCHEME 3 ;
	KEY ALT+S, ""
ON PAD _6741333rf OF _MSYSMENU ACTIVATE POPUP catalogos
ON PAD _6741333rg OF _MSYSMENU ACTIVATE POPUP cheques
ON PAD _6741333rh OF _MSYSMENU ACTIVATE POPUP informes
ON PAD _6741333ri OF _MSYSMENU ACTIVATE POPUP herramient
ON SELECTION PAD _6741333rk OF _MSYSMENU clear events

DEFINE POPUP catalogos MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF catalogos PROMPT "Bancos"
DEFINE BAR 2 OF catalogos PROMPT "Cuentas"
ON SELECTION BAR 1 OF catalogos do form Check_Bancos
ON SELECTION BAR 2 OF catalogos do form Check_Cuentas

DEFINE POPUP cheques MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF cheques PROMPT "Cheques"
DEFINE BAR 2 OF cheques PROMPT "Cuentas"
ON SELECTION BAR 1 OF cheques do form Mst_Cheques
ON SELECTION BAR 2 OF cheques do form mst_cuentas

DEFINE POPUP informes MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF informes PROMPT "Cheques emitidos"
DEFINE BAR 2 OF informes PROMPT "Plantilla"
ON SELECTION BAR 2 OF informes Do form Rp_plantilla

DEFINE POPUP herramient MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF herramient PROMPT "Configuración"
DEFINE BAR 2 OF herramient PROMPT "Limpiar datos"
ON SELECTION BAR 2 OF herramient do form cfg_limpieza
